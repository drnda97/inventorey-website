# Copy to .env.local and fill in. .env.local is git-ignored — never commit real credentials.

# SMTP server used by the early-access form (app/api/subscribe).
# Temporary: wanderway.rs mailbox until the inventorey domain has its own.
SMTP_HOST=
SMTP_PORT=465
# true for port 465 (SSL), false for 587 (STARTTLS). Defaults to true on 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Sender shown to subscribers, and the inbox that receives new signups.
MAIL_FROM="Inventorey <contact@wanderway.rs>"
MAIL_TO=contact@wanderway.rs
